# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Backend API
API_BASE=https://free-time.me/api

# Solana Pay
NEXT_PUBLIC_SOLANA_RECIPIENT=your_solana_wallet_address
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Halliday Payments (pk_... from https://dashboard.halliday.xyz) — pay with card/ACH/PayPal or receive USDC/USDT/SOL (Solana)
NEXT_PUBLIC_HALLIDAY_API_KEY=pk_live_...

# Arcade (cNFT minting lives in the API service — set these on the api service, not here)
# SOLANA_RPC_URL=https://helius-mainnet-rpc-url
# MINT_PRIVATE_KEY=base58_private_key_of_the_minting_wallet
# ARCADE_RECIPIENT=solana_wallet_that_receives_the_0.05_SOL
# ARCADE_JWT_SECRET=random_long_secret
# ARCADE_ADMIN_TOKEN=random_admin_token
