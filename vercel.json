{
  "services": {
    "root": {
      "root": ".",
      "framework": "nextjs",
      "routes": [
        { "handle": "filesystem" }
      ]
    },
    "api-dashboard": {
      "root": "api-dashboard/",
      "framework": "nextjs",
      "routes": [
        { "source": "/api-dashboard", "destination": "/" },
        { "source": "/api-dashboard/(.*)", "destination": "/$1" },
        { "source": "/dashboard/_next/:path*", "destination": "/_next/:path*" },
        { "handle": "filesystem" }
      ]
    },
    "api": {
      "root": "api/",
      "framework": "express"
    },
    "geoweather": {
      "root": "geoweather/",
      "framework": "nextjs",
      "routes": [
        { "handle": "filesystem" }
      ]
    },
    "sol-arcade": {
      "root": "sol-arcade/",
      "framework": "nextjs",
      "routes": [
        { "handle": "filesystem" }
      ]
    },
    "fdroid": {
      "root": "fdroid"
    }
  },
  "redirects": [
    { "source": "/api-dashboard/", "destination": "/api-dashboard", "permanent": true },
    { "source": "/arcade", "destination": "/sol-arcade", "permanent": true },
    { "source": "/arcade/:path*", "destination": "/sol-arcade/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": { "service": "root" } },
    { "source": "/api-dashboard/:path*", "destination": { "service": "api-dashboard" } },
    { "source": "/dashboard/:path*", "destination": { "service": "api-dashboard" } },
    { "source": "/login", "destination": { "service": "api-dashboard" } },
    { "source": "/logout", "destination": { "service": "api-dashboard" } },
    { "source": "/shop/:path*", "destination": { "service": "api-dashboard" } },
    { "source": "/sol-arcade", "destination": { "service": "sol-arcade" } },
    { "source": "/sol-arcade/:path*", "destination": { "service": "sol-arcade" } },
    { "source": "/health", "destination": { "service": "api-dashboard" } },
    { "source": "/auth/callback", "destination": { "service": "api-dashboard" } },
    { "source": "/api/proxy/:path*", "destination": { "service": "api-dashboard" } },
    { "source": "/api/:path*", "destination": { "service": "api" } },
    { "source": "/geoweather/:path*", "destination": { "service": "geoweather" } },
    { "source": "/fdroid/repo", "destination": { "service": "fdroid" } },
    { "source": "/fdroid/repo/:path*", "destination": { "service": "fdroid" } },
    { "source": "/:path*", "destination": { "service": "root" } }
  ]
}